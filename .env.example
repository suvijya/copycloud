# CopyCloud Server Configuration
# Copy this file to .env and update the values

# Server
NODE_ENV=development
PORT=3737
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=copycloud
DB_PASSWORD=copycloud
DB_NAME=copycloud
# Or use a connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/copycloud

# Redis (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# WebSocket
WS_MAX_PAYLOAD=1048576
WS_HEARTBEAT_INTERVAL=30000

# File Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760

# Limits
MAX_CLIPBOARD_ITEMS=100
MAX_CLIP_SIZE=1048576
MAX_DEVICES=10
MAX_USERS=1000

# Pairing
OTP_EXPIRY=120000
MAX_OTP_ATTEMPTS=5

# CORS (comma-separated origins, or * for development)
# ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
