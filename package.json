{
  "name": "copycloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:mobile": "npm run start -w apps/mobile",
    "dev:server": "npm run dev -w apps/server",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w apps/server",
    "test": "node scripts/test-api.js"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
