{
  "name": "copycloud",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-device clipboard synchronization",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:mobile": "cd apps/mobile && flutter run",
    "dev:server": "npm run dev -w apps/server",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w apps/server",
    "build:desktop": "npm run build -w apps/desktop",
    "build": "npm run build:shared && npm run build:server && npm run build:desktop",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint apps/server/src packages/shared/src --ext .ts",
    "lint:fix": "eslint apps/server/src packages/shared/src --ext .ts --fix",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.0"
  }
}
